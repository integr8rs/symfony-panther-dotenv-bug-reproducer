{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/string": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/panther": "^2.4"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestSuite\\": "tests/"
        }
    },
    "extra": {
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        }
    }
}
