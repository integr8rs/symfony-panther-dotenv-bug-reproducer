{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/string": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/panther": "^2.4"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestSuite\\": "tests/"
        }
    },
    "extra": {
        "runtime": {
            "class": "Symfony\\Component\\Runtime\\SymfonyRuntime"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "reproduce": "bash bin/reproduce.sh",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "scripts-descriptions": {
        "reproduce": "Builds a throwaway Docker container and runs the SYMFONY_DOTENV_VARS bug-reproduction tests, cleaning up afterward."
    }
}
