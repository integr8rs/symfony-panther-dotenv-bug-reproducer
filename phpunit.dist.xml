<?xml version="1.0" encoding="UTF-8"?>
<!-- https://docs.phpunit.de/en/12.0/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="./var/cache/test"
>
  <php>
    <ini name="display_errors" value="1"/>
    <ini name="error_reporting" value="-1"/>
    <env name="KERNEL_CLASS" value="App\Kernel"/>
    <env name="APP_SECRET" value="changeme"/>
    <server name="APP_ENV" value="test" force="true"/>
    <server name="SHELL_VERBOSITY" value="-1"/>
    <!-- ANIMAL is also declared in .env (see DotenvVarsTest) - this <env> element runs before
         tests/bootstrap.php's Dotenv::bootEnv() call, so by the time Dotenv looks at .env, ANIMAL
         is already set and gets skipped rather than tracked in SYMFONY_DOTENV_VARS. Note it must
         be an <env>, not a <server>, element - only <env> calls putenv(), which is what makes the
         value real process env, inherited by the Panther-managed web server's child process. -->
    <env name="ANIMAL" value="cat"/>
    <!-- FOOD is never declared in .env at all (see DotenvVarsTest) - Dotenv doesn't even consider
         it, let alone track it in SYMFONY_DOTENV_VARS. -->
    <env name="FOOD" value="pizza"/>
  </php>
  <testsuites>
    <testsuite name="Panther">
      <directory>tests/</directory>
    </testsuite>
  </testsuites>
  <extensions>
    <bootstrap class="Symfony\Component\Panther\ServerExtension"/>
  </extensions>
</phpunit>
